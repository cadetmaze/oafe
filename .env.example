# Copy this file to .env. Host processes (Next.js and npm run db:migrate) use
# DATABASE_URL. Docker Compose overrides that value inside containers with
# DOCKER_DATABASE_URL, because the local database has a different hostname and
# port on the Docker network. For a remote database, set both values to the
# same remote connection string, or leave DOCKER_DATABASE_URL empty to fall
# back to DATABASE_URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/datacurate
DOCKER_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/datacurate
NEXT_PUBLIC_API_URL=http://localhost:8000
POSTGRES_PORT=5433

# Optional Supabase Auth. Guests work without these values.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional but strongly recommended: raises Hugging Face rate limits a lot.
HF_TOKEN=

# Only needed for the "push_hf" export mode (per-request from the frontend
# normally, but useful for CLI testing).
# HF_TOKEN_FOR_PUSH=

# ── Orbitrage (the only LLM provider used by this project) ─────────────
# OpenAI-compatible gateway. Without it, the agent uses keyword fallbacks.
ORBITRAGE_API_KEY=
ORBITRAGE_BASE_URL=https://api.orbitrage.ai/v1
ORBITRAGE_MODEL_PLAN=gpt-oss-120b
ORBITRAGE_MODEL_SEARCH=glm-4.7
ORBITRAGE_MODEL_VISION=qwen3-vl-235b-a22b-instruct
ORBITRAGE_SEARCH_TOOL=tavily_orbitrage
